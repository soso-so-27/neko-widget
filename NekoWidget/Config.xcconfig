// Registered release identifiers. Keep literal values here: the TestFlight
// workflow reads these three lines directly before xcodebuild. Change them
// only after making the corresponding Developer Portal changes, and always
// update all affected identifiers together. Do not derive values with $(...).
APP_BUNDLE_IDENTIFIER = jp.nekowidget.app
WIDGET_BUNDLE_IDENTIFIER = jp.nekowidget.app.widget
SHARE_EXTENSION_BUNDLE_IDENTIFIER = jp.nekowidget.app.share
APP_GROUP_IDENTIFIER = group.jp.nekowidget.app

// v1 supports iOS 17.1 and later.
IPHONEOS_DEPLOYMENT_TARGET = 17.1

// Shared version defaults. Xcode target settings may override these values.
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// General app policy links are distinct from the sharing-runtime policy.
// Individual release overlays must select truthful URLs for their scope.
APP_PRIVACY_URL =
APP_SUPPORT_URL =

// Sharing is opt-in per build. Release/TestFlight stays off until the
// privacy, moderation, and export-compliance gates are completed.
// This is the local development/review default and the Build 27 preview
// boundary. The release workflow defaults to the all-off disabled tuple.
// Config.PairingOnly.xcconfig and Config.MediaStaging.xcconfig record the
// explicit test policies. The release workflow applies their values as
// xcodebuild overrides so target-specific provisioning mappings remain intact.
SHARING_RELEASE_MODE = review-preview
SHARING_FEATURE_ENABLED = NO
SHARING_API_BASE_URL =
// Pairing can be exercised independently. One-photo moment upload/download
// remains separately off until privacy, safety, staging, and device gates pass.
SHARING_MEDIA_ENABLED = NO
// The Share Extension may write one protected, short-lived canonical input.
// Only the host app may validate the current installation, encrypt and send.
SHARING_SHARE_EXTENSION_HANDOFF_ENABLED = NO
// Direct Share Extension delivery cannot be enabled until the extension can
// prove that the host app validated this installation after a reinstall.
// Candidate/review builds keep the extension visible but fail closed here.
SHARING_SHARE_EXTENSION_SEND_ENABLED = NO
// Shows the adopted ADR-015 screens for product review only. This flag must
// never create a client, access sharing credentials, or send any data.
SHARING_REVIEW_PREVIEW_ENABLED = YES
// Required together before media runtime can turn on. The public key encrypts
// a separate short-lived copy only when the recipient explicitly reports a
// received moment; the Worker cannot decrypt it.
SHARING_MODERATION_KEY_ID =
SHARING_MODERATION_PUBLIC_KEY =
SHARING_PRIVACY_URL =
SHARING_SUPPORT_URL =
SHARING_COMMUNITY_STANDARDS_URL =

// Purpose-string and Share Extension plist defaults for non-Release local
// development. Release configurations use Config.Disabled.xcconfig, while the
// protected TestFlight workflow supplies explicit per-mode overrides.
PHOTO_LIBRARY_USAGE_DESCRIPTION = 猫の写真を端末内で見つけて整理し、「うちの子」アルバムとウィジェットへ反映するため、写真ライブラリへのアクセスを許可してください。写真の解析とウィジェット用画像の作成は端末内で行います。
SHARE_EXTENSION_INFOPLIST_FILE = NekoWidgetShareExtension/Info.plist

// GitHub Actions injects the names extracted from the three distribution
// provisioning profiles. Keep these empty for Xcode automatic signing.
APP_PROVISIONING_PROFILE_SPECIFIER =
WIDGET_PROVISIONING_PROFILE_SPECIFIER =
SHARE_EXTENSION_PROVISIONING_PROFILE_SPECIFIER =
