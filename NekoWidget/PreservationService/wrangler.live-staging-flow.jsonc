{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neko-preservation-live-staging-flow-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": { "PRESERVATION_ENABLED": "NO", "ENVIRONMENT": "local-staging-probe" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "neko-preservation-live-staging-flow-local",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }, {
    "binding": "RESTORE_DB",
    "database_name": "neko-preservation-live-staging-restore-local",
    "database_id": "00000000-0000-0000-0000-000000000001",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{
    "binding": "ARCHIVE",
    "bucket_name": "neko-preservation-staging-private",
    "remote": true
  }]
}
