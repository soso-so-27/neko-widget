{
  // Local wrangler dev only. Never deploy this browser bridge.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neko-preservation-s3-local-binding-probe",
  "main": "scripts/staging-s3-binding-probe.ts",
  "compatibility_date": "2026-08-17",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "services": [{
    "binding": "RECOVERY_PROBE",
    "service": "neko-preservation-staging-disabled",
    "remote": true
  }]
}
