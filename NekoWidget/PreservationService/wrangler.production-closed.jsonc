{
  "$schema": "node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_request_signal"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "triggers": {
    "crons": []
  },
  "name": "neko-preservation-production",
  "main": "src/index.ts",
  "vars": {
    "ENVIRONMENT": "production",
    "PRESERVATION_ENABLED": "NO",
    "INTAKE_ENABLED": "NO",
    "PILOT_MODE": "NO",
    "PILOT_STORAGE_ACCESS_ENABLED": "NO",
    "PILOT_REGISTRATION_ENABLED": "NO",
    "GENERAL_STORAGE_MODE": "NO",
    "OWNER_DELETION_ENABLED": "NO",
    "CLEANUP_ENABLED": "NO",
    "RETENTION_TRACKING_ENABLED": "NO",
    "RECOVERY_BACKFILL_ENABLED": "NO",
    "OWNER_RECOVERY_COMPRESSION_ENABLED": "NO",
    "OWNER_RECOVERY_PAGED_ENABLED": "NO",
    "NOTICE_SEND_ENABLED": "NO",
    "NOTICE_EVENTS_ENABLED": "NO",
    "NOTICE_RUN_MONITOR_ENABLED": "NO",
    "RECOVERY_COPY_ENABLED": "NO",
    "RECOVERY_S3_REGION": "ap-northeast-1",
    "RECOVERY_S3_BUCKET": "neko-preservation-production-recovery-164892691568",
    "RECOVERY_S3_ACCOUNT_ID": "164892691568",
    "PRESERVATION_LINK_AUDIENCE": "neko-preservation-production",
    "OWNER_QUOTA_BYTES": "53687091200",
    "MAXIMUM_RECORDS": "200000",
    "GLOBAL_ACTIVE_STORAGE_LIMIT_BYTES": "107374182400",
    "PRODUCT_PLUS_BYTES": "3000000000",
    "PRODUCT_TRIAL_BYTES": "250000000",
    "PRODUCT_VISIBLE_RECORDS": "3000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "neko-preservation-production",
      "database_id": "e1f34d4a-dcb4-472b-9cbc-37233a52c5b1",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARCHIVE",
      "bucket_name": "neko-preservation-production-private"
    }
  ],
  "services": [
    {
      "binding": "KEY_WRAPPER",
      "service": "neko-preservation-kms-production",
      "entrypoint": "PreservationKeyWrapper"
    },
    {
      "binding": "MEMBERSHIP_AUTHORITY",
      "service": "neko-preservation-billing-production",
      "entrypoint": "BillingAuthority"
    },
    {
      "binding": "PHOTO_VALIDATOR",
      "service": "neko-preservation-jpeg-production",
      "entrypoint": "JPEGValidationService"
    }
  ],
  "ratelimits": [
    {
      "name": "REQUEST_LIMITER",
      "namespace_id": "720004",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
