{
  "Version": "2012-10-17",
  "Statement": [{
    "Sid": "OnlyPreservationStagingWrapUnwrapWithExactContextKey",
    "Effect": "Allow",
    "Action": ["kms:Encrypt", "kms:Decrypt"],
    "Resource": "arn:aws:kms:ap-northeast-1:164892691568:key/339319dc-388b-4bd7-adb8-29d37d836d72",
    "Condition": {
      "Null": {
        "kms:EncryptionContextKeys": false
      },
      "ForAllValues:StringEquals": {
        "kms:EncryptionContextKeys": "neko-preservation-context-sha256"
      }
    }
  }]
}
