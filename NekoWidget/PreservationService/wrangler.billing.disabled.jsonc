{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neko-preservation-billing-disabled-local",
  "main": "src/billing-authority.ts",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "PRESERVATION_BILLING_ENABLED": "NO",
    "PRESERVATION_LINK_AUDIENCE": "neko-preservation-disabled-local",
    "BILLING_EFFECTIVE_ENTITLEMENT_RUNTIME_ENABLED": "NO"
  },
  // Activation must explicitly bind the existing Sharing billing database.
  // No migrations_dir: this worker never owns or migrates that database.
  "d1_databases": [{ "binding": "DB", "database_name": "neko-billing-disabled-local", "database_id": "00000000-0000-0000-0000-000000000000" }]
}
