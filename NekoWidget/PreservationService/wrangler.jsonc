{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neko-preservation-disabled-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": false },
  "vars": { "PRESERVATION_ENABLED": "NO", "OWNER_RECOVERY_COMPRESSION_ENABLED": "NO", "ENVIRONMENT": "local" },
  "d1_databases": [{ "binding": "DB", "database_name": "neko-preservation-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "ARCHIVE", "bucket_name": "neko-preservation-local-private" }],
  "env": {
    "staging": {
      "name": "neko-preservation-staging-disabled",
      "workers_dev": false,
      "vars": {
        "PRESERVATION_ENABLED": "NO",
        "PILOT_MODE": "YES",
        "OWNER_QUOTA_BYTES": "1073741824",
        "MAXIMUM_RECORDS": "200",
        "GLOBAL_ACTIVE_STORAGE_LIMIT_BYTES": "3221225472",
        "CLEANUP_ENABLED": "NO",
        "RECOVERY_BACKFILL_ENABLED": "NO",
        "RECOVERY_COPY_ENABLED": "NO",
        "RECOVERY_S3_REGION": "ap-northeast-1",
        "RECOVERY_S3_BUCKET": "neko-preservation-staging-recovery-164892691568",
        "RECOVERY_S3_ACCOUNT_ID": "164892691568",
        "OWNER_RECOVERY_COMPRESSION_ENABLED": "NO",
        "RETENTION_TRACKING_ENABLED": "NO",
        "PRESERVATION_LINK_AUDIENCE": "neko-preservation-staging",
        "ENVIRONMENT": "staging"
      },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "neko-preservation-staging",
        "database_id": "955a8530-9015-486c-8d0c-1b5a2c5b6d4f",
        "migrations_dir": "migrations"
      }],
      "r2_buckets": [{
        "binding": "ARCHIVE",
        "bucket_name": "neko-preservation-staging-private"
      }],
      "ratelimits": [{
        "name": "REQUEST_LIMITER",
        "namespace_id": "170927401",
        "simple": { "limit": 120, "period": 60 }
      }],
      "services": [{
        "binding": "PHOTO_VALIDATOR",
        "service": "neko-preservation-jpeg-disabled",
        "entrypoint": "JPEGValidationService"
      }, {
        "binding": "KEY_WRAPPER",
        "service": "neko-preservation-kms-staging-disabled",
        "entrypoint": "PreservationKeyWrapper"
      }, {
        "binding": "MEMBERSHIP_AUTHORITY",
        "service": "neko-preservation-billing-staging-disabled",
        "entrypoint": "BillingAuthority"
      }]
    }
  }
}
