{
  "$schema": "node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "triggers": {
    "crons": []
  },
  "name": "neko-preservation-retention-production",
  "main": "src/retention-entry.ts",
  "vars": {
    "ENVIRONMENT": "production",
    "INTAKE_ENABLED": "NO",
    "PRESERVATION_RETENTION_REFRESH_ENABLED": "NO",
    "BILLING_SUBSCRIPTION_RECONCILIATION_RUNTIME_ENABLED": "NO",
    "BILLING_EFFECTIVE_ENTITLEMENT_RUNTIME_ENABLED": "NO",
    "BILLING_STORE_ENVIRONMENT": "Production",
    "BILLING_ACCEPT_SANDBOX_IN_PRODUCTION": "NO",
    "BILLING_SANDBOX_OWNER_ONLY_REQUIRED": "NO",
    "BILLING_VERIFIER_TRANSPORT": "https-access",
    "BILLING_VERIFIER_ORIGIN": "https://billing-verifier.nekonomado.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "neko-window-sharing-production",
      "database_id": "f0622d76-41d5-4af2-87c4-54f0ebc4015f"
    }
  ]
}
