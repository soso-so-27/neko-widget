{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyProductionRecoveryObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::neko-preservation-production-recovery-164892691568/recovery/v1/*"
    },
    {
      "Sid": "OnlyProductionRecoveryInventory",
      "Effect": "Allow",
      "Action": "s3:ListBucketVersions",
      "Resource": "arn:aws:s3:::neko-preservation-production-recovery-164892691568",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "recovery/v1/*",
            "purge/v1/*"
          ]
        }
      }
    },
    {
      "Sid": "OnlyPurgeLedgerRead",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::neko-preservation-production-recovery-164892691568/purge/v1/*"
    }
  ]
}
