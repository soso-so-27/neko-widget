{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neko-preservation-billing-staging-disabled",
  "main": "src/billing-authority.ts",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "PRESERVATION_BILLING_ENABLED": "NO",
    "PRESERVATION_LINK_AUDIENCE": "neko-preservation-staging",
    "BILLING_EFFECTIVE_ENTITLEMENT_RUNTIME_ENABLED": "NO",
    // Match the gateway policy when activating; these templates stay disabled.
    "BILLING_STORE_ENVIRONMENT": "Sandbox",
    "BILLING_ACCEPT_SANDBOX_IN_PRODUCTION": "NO",
    "BILLING_SANDBOX_OWNER_ONLY_REQUIRED": "NO"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "neko-window-sharing-staging",
    "database_id": "cb3b2386-3a6f-4253-b918-8aafed9ff735"
  }]
}
