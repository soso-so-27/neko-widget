{
  "$schema": "node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "triggers": {
    "crons": []
  },
  "name": "neko-preservation-owner-deletion-production",
  "main": "src/owner-deletion-worker.ts",
  "vars": {
    "ENVIRONMENT": "production",
    "OWNER_DELETION_EXECUTOR_ENABLED": "NO",
    "RECOVERY_COPY_ENABLED": "NO",
    "RECOVERY_S3_REGION": "ap-northeast-1",
    "RECOVERY_S3_BUCKET": "neko-preservation-production-recovery-164892691568",
    "RECOVERY_S3_ACCOUNT_ID": "164892691568"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "neko-preservation-production",
      "database_id": "e1f34d4a-dcb4-472b-9cbc-37233a52c5b1",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARCHIVE",
      "bucket_name": "neko-preservation-production-private"
    }
  ],
  "services": [
    {
      "binding": "KEY_WRAPPER",
      "service": "neko-preservation-kms-production",
      "entrypoint": "PreservationKeyWrapper"
    },
    {
      "binding": "RECOVERY_INVENTORY",
      "service": "neko-preservation-production",
      "entrypoint": "OwnerDeletionInventory"
    }
  ]
}
