// Explicit public 1.0 overlay: xcodebuild -configuration Release
// -xcconfig Config.Production.xcconfig. Ordinary Release remains disabled.
// Supply reviewed deployment values in an approved overlay/CI environment.
// Empty endpoints/recipient key intentionally fail closed; no staging fallback.
#include "Config.xcconfig"

SHARING_RELEASE_MODE = production
SHARING_FEATURE_ENABLED = YES
SHARING_MEDIA_ENABLED = YES
GROUP_WINDOWS_ENABLED = YES
FAMILY_NOTEBOOK_PRODUCTION_ENABLED = YES
GROUP_REPORTING_PRODUCTION_ENABLED = YES
SHARING_SHARE_EXTENSION_HANDOFF_ENABLED = YES
SHARING_SHARE_EXTENSION_SEND_ENABLED = NO
SHARING_REVIEW_PREVIEW_ENABLED = NO
MANAGED_PRESERVATION_ENABLED = YES
PLUS_STOREFRONT_ENABLED = YES
PLUS_BILLING_CLIENT_ENABLED = YES
PLUS_BILLING_RECOVERY_ENABLED = YES
PLUS_WINDOW_SPONSORSHIP_CLIENT_ENABLED = NO
MEMBERSHIP_ACCESS_ENFORCED = YES
PLUS_MONTHLY_PRODUCT_ID = jp.nekowidget.plus.monthly
PLUS_ANNUAL_PRODUCT_ID =

SHARING_API_BASE_URL =
PLUS_BILLING_API_BASE_URL = $(SHARING_API_BASE_URL)
MANAGED_PRESERVATION_ORIGIN =
MANAGED_PRESERVATION_MEMBERSHIP_AUDIENCE =
SHARING_MODERATION_KEY_ID = moderation-v2
SHARING_MODERATION_PUBLIC_KEY =
APP_PRIVACY_URL =
APP_SUPPORT_URL =
SHARING_PRIVACY_URL = $(APP_PRIVACY_URL)
SHARING_SUPPORT_URL = $(APP_SUPPORT_URL)
SHARING_COMMUNITY_STANDARDS_URL =
OFFICIAL_WINDOW_FEED_URL =
APP_PRIVACY_MANIFEST_PATH = Production/PrivacyInfo.xcprivacy

// Keep access to existing private CloudKit records. No new archive or upload.
PERSONAL_ARCHIVE_ENABLED = YES
PERSONAL_ARCHIVE_READ_ONLY = YES
