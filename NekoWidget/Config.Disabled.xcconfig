// Local-only release boundary. This overlay keeps the photo library, local
// curation, personal likes, and personal Widget available while removing every
// invite-only sharing surface and network value from the processed archive.
#include "Config.xcconfig"

SHARING_RELEASE_MODE = disabled
SHARING_FEATURE_ENABLED = NO
GROUP_WINDOWS_ENABLED = NO
SHARING_MEDIA_ENABLED = NO
SHARING_SHARE_EXTENSION_HANDOFF_ENABLED = NO
SHARING_SHARE_EXTENSION_SEND_ENABLED = NO
SHARING_REVIEW_PREVIEW_ENABLED = NO

SHARING_API_BASE_URL =
SHARING_MODERATION_KEY_ID =
SHARING_MODERATION_PUBLIC_KEY =
SHARING_PRIVACY_URL =
SHARING_SUPPORT_URL =
SHARING_COMMUNITY_STANDARDS_URL =

// Xcconfig treats a literal // as a comment. $() expands to an empty value so
// the resolved build setting contains the intended public HTTPS URL.
APP_PRIVACY_URL = https:/$()/soso-so-27.github.io/neko-widget/app/privacy/
APP_SUPPORT_URL = https:/$()/soso-so-27.github.io/neko-widget/app/support/

// An ordinary Release/Archive must remain truthful and must not advertise the
// Share Extension. Media-staging can override both values only in the guarded
// release workflow, where the processed archive is validated again.
PHOTO_LIBRARY_USAGE_DESCRIPTION = 猫の写真をiPhoneの中で見つけて、アルバムとホーム画面のウィジェットに出すために使います。
SHARE_EXTENSION_INFOPLIST_FILE = NekoWidgetShareExtension/Info.Disabled.plist

// Anonymous daily usage; empty means no transmission.
USAGE_REPORT_URL =
