// Dedicated TestFlight mode for the two-device pairing exercise.
// Keep the API origin empty in the repository. testflight.yml injects it only
// from the protected testflight Environment variable SHARING_STAGING_API_ORIGIN.
#include "Config.xcconfig"

SHARING_RELEASE_MODE = pairing-only
SHARING_FEATURE_ENABLED = YES
SHARING_API_BASE_URL =

// Pairing-only must never inherit any current or future photo path.
SHARING_MEDIA_ENABLED = NO
SHARING_SHARE_EXTENSION_HANDOFF_ENABLED = NO
SHARING_SHARE_EXTENSION_SEND_ENABLED = NO
SHARING_REVIEW_PREVIEW_ENABLED = NO

SHARING_MODERATION_KEY_ID =
SHARING_MODERATION_PUBLIC_KEY =
SHARING_SUPPORT_URL =
SHARING_COMMUNITY_STANDARDS_URL =
