// Dedicated TestFlight policy for a two-device, one-photo staging exercise.
// Operational values stay empty in source. testflight.yml injects them only
// from protected variables in the GitHub `testflight` Environment.
#include "Config.xcconfig"

SHARING_RELEASE_MODE = media-staging
SHARING_FEATURE_ENABLED = YES
SHARING_MEDIA_ENABLED = YES
SHARING_SHARE_EXTENSION_HANDOFF_ENABLED = YES
SHARING_SHARE_EXTENSION_SEND_ENABLED = NO
SHARING_REVIEW_PREVIEW_ENABLED = NO

SHARING_API_BASE_URL =
SHARING_MODERATION_KEY_ID =
SHARING_MODERATION_PUBLIC_KEY =
SHARING_PRIVACY_URL =
SHARING_SUPPORT_URL =
SHARING_COMMUNITY_STANDARDS_URL =
