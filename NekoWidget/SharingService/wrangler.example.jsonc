{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neko-window-sharing",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-17",
  "workers_dev": false,
  "observability": {
    "enabled": false,
    "logs": { "enabled": false }
  },
  "limits": { "cpu_ms": 30000, "subrequests": 1200 },
  "vars": {
    "ENVIRONMENT": "production",
    "INVITATION_TTL_SECONDS": "86400",
    "CHALLENGE_TTL_SECONDS": "300",
    "PENDING_TTL_SECONDS": "86400",
    "IDEMPOTENCY_TTL_SECONDS": "172800",
    "SPACE_INACTIVITY_TTL_SECONDS": "2592000"
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "replace-with-d1-name",
      "database_id": "11111111-1111-4111-8111-111111111111",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "replace-with-private-r2-bucket"
    }
  ],
  "ratelimits": [
    {
      "name": "CREATE_RATE_LIMITER",
      "namespace_id": "100001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "INVITE_RATE_LIMITER",
      "namespace_id": "100002",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "MEMBER_RATE_LIMITER",
      "namespace_id": "100003",
      "simple": { "limit": 120, "period": 60 }
    }
  ]
}
