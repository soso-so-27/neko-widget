{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neko-window-sharing",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-17",
  "workers_dev": false,
  "observability": {
    "enabled": false,
    "logs": { "enabled": false }
  },
  "limits": { "cpu_ms": 30000, "subrequests": 1200 },
  "vars": {
    "ENVIRONMENT": "production",
    "MOMENT_RUNTIME_ENABLED": "NO",
    "REPORT_INGESTION_RUNTIME_ENABLED": "NO",
    "REACTION_RUNTIME_ENABLED": "NO",
    "WINDOW_NAME_RUNTIME_ENABLED": "NO",
    "APNS_RUNTIME_ENABLED": "NO",
    "LEGACY_SHARING_RUNTIME_ENABLED": "NO",
    "BILLING_ACCOUNT_BOOTSTRAP_RUNTIME_ENABLED": "NO",
    "BILLING_TRANSACTION_INGESTION_RUNTIME_ENABLED": "NO",
    "BILLING_APPLE_NOTIFICATION_RUNTIME_ENABLED": "NO",
    "BILLING_APPLE_NOTIFICATION_HISTORY_RECOVERY_RUNTIME_ENABLED": "NO",
    "BILLING_SUBSCRIPTION_RECONCILIATION_RUNTIME_ENABLED": "NO",
    "BILLING_EFFECTIVE_ENTITLEMENT_RUNTIME_ENABLED": "NO",
    "BILLING_ACCOUNT_RECOVERY_RUNTIME_ENABLED": "NO",
    "BILLING_WINDOW_SPONSORSHIP_RUNTIME_ENABLED": "NO",
    "INVITATION_TTL_SECONDS": "86400",
    "CHALLENGE_TTL_SECONDS": "300",
    "PENDING_TTL_SECONDS": "86400",
    "IDEMPOTENCY_TTL_SECONDS": "172800",
    "SPACE_INACTIVITY_TTL_SECONDS": "2592000"
  },
  "triggers": {
    "crons": [
      "* * * * *",
      "*/5 * * * *",
      "2,7,12,17,22,27,32,37,42,47,52,57 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "replace-with-d1-name",
      "database_id": "11111111-1111-4111-8111-111111111111",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "replace-with-private-r2-bucket"
    },
    {
      "binding": "MODERATION_MEDIA",
      "bucket_name": "replace-with-private-moderation-r2-bucket"
    }
  ],
  "ratelimits": [
    {
      "name": "CREATE_RATE_LIMITER",
      "namespace_id": "100001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "INVITE_RATE_LIMITER",
      "namespace_id": "100002",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "MEMBER_RATE_LIMITER",
      "namespace_id": "100003",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "BILLING_RATE_LIMITER",
      "namespace_id": "100004",
      "simple": { "limit": 30, "period": 60 }
    }
    // BILLING_APPLE_NOTIFICATION_RATE_LIMITER is intentionally absent here.
    // Keep its runtime gate OFF until a separate production namespace and an
    // observed, reviewed threshold replace this fail-closed example.
  ]
}
