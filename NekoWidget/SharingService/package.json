{
  "name": "neko-window-sharing-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "npm run typecheck && npm run check:staging-config && npm run check:notification-staging-status && npm run check:moderation-case-lifecycle && npm run check:moderation-operator-control-plane && npm run check:moderation-evidence-ledger && npm run check:moderation-operator-routes && npm run check:moderation-operator-config && npm run check:moderation-staging-status && npm run check:selective-staging-off && npm run check:staging-runtime && npm run check:public-policy-site && npm run check:moderation-tool && npm run check:moderation-keygen && npm run check:moderation-drill && npm test",
    "check:staging-config": "node --test scripts/staging-config.node-tests.mjs",
    "check:staging-runtime": "node --test test/staging-runtime-check.node-tests.mjs",
    "check:public-policy-site": "node --test test/public-policy-site-check.node-tests.mjs",
    "check:moderation-tool": "node --test test/moderation-report-tool.node-tests.mjs test/moderation-report-windows-boundary.node-tests.mjs",
    "check:moderation-keygen": "node --test test/moderation-staging-keygen.node-tests.mjs",
    "check:moderation-drill": "node --test test/moderation-staging-drill.node-tests.mjs",
    "check:moderation-case-lifecycle": "node --test test/moderation-case-lifecycle.node-tests.mjs",
    "check:moderation-operator-control-plane": "node --test test/moderation-operator-control-plane.node-tests.mjs",
    "check:moderation-evidence-ledger": "node --test test/moderation-evidence-ledger.node-tests.mjs",
    "check:moderation-operator-routes": "node --test test/moderation-operator-routes.node-tests.mjs",
    "check:moderation-operator-config": "node --test test/moderation-operator-config.node-tests.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "wrangler dev --config wrangler.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply neko-window-sharing-local --local --config wrangler.jsonc",
    "staging:config:render": "node scripts/render-staging-config.mjs",
    "staging:config:check": "node scripts/check-staging-config.mjs",
    "media-staging:config:render": "node scripts/render-media-staging-config.mjs",
    "media-staging:config:check": "node scripts/check-media-staging-config.mjs",
    "notification-staging:config:render": "node scripts/render-notification-staging-config.mjs",
    "notification-staging:config:check": "node scripts/check-notification-staging-config.mjs",
    "notification-staging:status": "node scripts/check-notification-staging-status.mjs",
    "moderation-staging:status": "node scripts/check-moderation-staging-status.mjs",
    "moderation-operator:config:check": "node scripts/check-moderation-operator-config.mjs",
    "report-ingestion-staging:config:render": "node scripts/render-report-ingestion-staging-config.mjs",
    "report-ingestion-staging:config:check": "node scripts/check-report-ingestion-staging-config.mjs",
    "general-staging:config:render": "node scripts/render-general-staging-config.mjs",
    "general-staging:apns-off-config:render": "node scripts/render-general-staging-apns-off-config.mjs",
    "selective-staging-off:config:check": "node scripts/check-selective-staging-off-configs.mjs",
    "check:notification-staging-status": "node --test test/notification-staging-status.node-tests.mjs",
    "check:moderation-staging-status": "node --test test/moderation-staging-status.node-tests.mjs",
    "check:selective-staging-off": "node --test test/selective-staging-off.node-tests.mjs",
    "staging:runtime:check": "node scripts/check-staging-runtime.mjs",
    "public-policy-site:check": "node scripts/check-public-policy-site.mjs",
    "staging:runtime:emergency-off": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/personal-staging-emergency-off-windows.ps1 -DryRun",
    "staging:runtime:apns-off": "node scripts/personal-staging-apns-off.mjs --local-dry-run",
    "staging:runtime:report-ingestion-off": "node scripts/personal-staging-report-ingestion-off.mjs --local-dry-run",
    "staging:runtime:media-off": "node scripts/personal-staging-media-off.mjs --local-dry-run",
    "moderation:tool": "node scripts/moderation-report-tool.mjs",
    "moderation:keygen:staging": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/moderation-staging-keygen-windows.ps1",
    "moderation:drill:staging": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/moderation-staging-drill-windows.ps1",
    "moderation:drill:review:staging": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/moderation-staging-drill-review-windows.ps1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.21.3",
    "@cloudflare/workers-types": "5.20260822.1",
    "@types/node": "24.10.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "4.125.0"
  }
}
